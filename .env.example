DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters
GITHUB_TOKEN=github-personal-access-token-with-read-user-access
GITHUB_USERNAME=proSamik
GITHUB_CONTRIBUTIONS_START_YEAR=2020
YOUTUBE_API_KEY=youtube-data-api-key
YOUTUBE_HANDLE=proSamik

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_CORS_ORIGINS=https://prosamik.com,https://www.prosamik.com,http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public browser origin (for example https://prosamik.com), including behind a reverse proxy.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=replace-with-a-random-secret-with-at-least-32-characters
AUTH_ADMIN_EMAIL=
R2_BUCKET_NAME=
# Server-only, private accountability media bucket. Never use a NEXT_PUBLIC_ prefix.
SECURE_BUCKET=prosamik-secure-bucket

# Optional canonical MCP resource URL; leave blank to derive /api/mcp from BETTER_AUTH_URL.
MCP_RESOURCE_URL=
# The trusted reverse-proxy header overwritten with the client IP. Keep default for Cloudflare;
# set another supported header only when your proxy overwrites it.
MCP_TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# Keep live reminder delivery disabled until a delivery adapter is configured and tested.
ACCOUNTABILITY_REMINDER_DELIVERY_ENABLED=false

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
