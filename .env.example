DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters
GITHUB_TOKEN=github-personal-access-token-with-read-user-access
GITHUB_USERNAME=proSamik
GITHUB_CONTRIBUTIONS_START_YEAR=2020
YOUTUBE_API_KEY=youtube-data-api-key
YOUTUBE_HANDLE=proSamik

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_CORS_ORIGINS=https://prosamik.com,https://www.prosamik.com,http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public browser origin (for example https://prosamik.com), including behind a reverse proxy.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=replace-with-a-random-secret-with-at-least-32-characters
AUTH_ADMIN_EMAIL=
R2_BUCKET_NAME=
# Server-only, private accountability media bucket. Never use a NEXT_PUBLIC_ prefix.
SECURE_BUCKET=prosamik-secure-bucket

# Optional canonical MCP resource URL; leave blank to derive /api/mcp from BETTER_AUTH_URL.
MCP_RESOURCE_URL=
# The trusted reverse-proxy header overwritten with the client IP. Keep default for Cloudflare;
# set another supported header only when your proxy overwrites it.
MCP_TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# Keep live reminder delivery disabled until a delivery adapter is configured and tested.
ACCOUNTABILITY_REMINDER_DELIVERY_ENABLED=false

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Newsletter signup (self-hosted Plunk). The form posts to /api/newsletter, which adds the contact as subscribed.
# Base URL of your Plunk API (no trailing slash and no /v1).
PLUNK_API_URL=
# Public key: used server-side to track the signup event and subscribe the contact.
PLUNK_PUBLIC_API_KEY=
# Secret key (optional here): enables email verification (disposable/typo check) and contact management.
PLUNK_SECRET_API_KEY=
# Event name a Plunk workflow listens to for the welcome email. Defaults to newsletter-signup.
PLUNK_NEWSLETTER_EVENT=newsletter-signup
# Sender used for transactional/welcome emails you send from this app.
PLUNK_FROM_EMAIL=
PLUNK_FROM_NAME=
PLUNK_REPLY_TO_EMAIL=
# Public origin of this site (for example https://prosamik.com). The signup API only accepts requests from it in production.
NEXT_PUBLIC_SITE_URL=
